datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model Room {
  id           String   @id @default(uuid())
  roomNumber   String   @unique
  phase        Int      @default(0) // 0:待機, 1:役職配布, 2:昼議論, 3:投票中, 4:夜行動, 5:終了
  dayCount     Int      @default(1)
  totalPlayers Int
  players      Player[]
}

model Player {
  id         String  @id @default(uuid())
  name       String
  role       String? // "VILLAGER", "WEREWOLF", "SEER" など
  isAlive    Boolean @default(true)
  room       Room    @relation(fields: [roomId], references: [id])
  roomId     String
}